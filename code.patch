-    lower_parts = {part.lower() for part in path.parent.parts}
-    if lower_parts & IMAGE_SKIP_DIRS:
-        return False
-    dims = get_image_dimensions(path)
-    if dims is not None:
-        w, h = dims
-        if w < MIN_IMAGE_DIM or h < MIN_IMAGE_DIM:
-            return False
-    return True
