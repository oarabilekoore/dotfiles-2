-def walk_files(max_depth: int = 6, max_results: int = 5000) -> list[tuple[Path, int, int, bool]]:
-    found = []
-    for root in SEARCH_ROOTS:
-        if not root.exists():
-            continue
-        base_depth = len(root.parts)
-        for dirpath, dirnames, filenames in os.walk(root):
-            cur = Path(dirpath)
-            depth = len(cur.parts) - base_depth
-            dirnames[:] = [
-                d for d in dirnames
-                if d not in SKIP_DIRS and not d.startswith(".")
-            ]
-            if depth > 0:
-                try:
-                    st = cur.stat()
-                    found.append((cur, int(st.st_mtime), 0, True))
-                except OSError:
-                    pass
-            if depth >= max_depth:
-                dirnames[:] = []
-            for fn in filenames:
-                if fn.startswith("."):
-                    continue
-                fp = cur / fn
-                try:
-                    st = fp.stat()
-                    found.append((fp, int(st.st_mtime), int(st.st_size), False))
-                except OSError:
-                    continue
-                if len(found) >= max_results:
-                    return found
-    return found
