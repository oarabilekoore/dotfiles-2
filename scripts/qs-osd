#!/usr/bin/env bash
set -euo pipefail

if ! command -v quickshell >/dev/null 2>&1; then
    printf '%s\n' 'quickshell was not found in PATH' >&2
    exit 127
fi

if (($# == 0)); then
    printf 'Usage: %s "message to show in the bar clock"\n' "$0" >&2
    exit 2
fi

message="$*"
exec quickshell ipc call osd status "$message"
