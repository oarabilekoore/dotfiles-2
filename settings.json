{
  "colorScheme": "wallust",
  "wallustAutoReload": true,
  "accentColor": "#7aa2f7",
  "fontFamily": "JetBrainsMono Nerd Font",
  "fontScale": 1,
  "cornerRadius": 0,
  "borderWidth": 1,
  "barPosition": "top",
  "barHeight": 32,
  "barFloating": false,
  "barMargin": 0,
  "showWorkspaces": true,
  "showMpris": true,
  "showDictation": true,
  "showCaffeine": true,
  "showTray": true,
  "showNetwork": true,
  "showBluetooth": true,
  "showBattery": true,
  "showClock": true,
  "gapsIn": 4,
  "gapsOut": 8,
  "hyprBorderSize": 1,
  "hyprRounding": 0,
  "hyprLayout": "dwindle",
  "hyprBlur": false,
  "hyprBlurPasses": 2,
  "hyprShadows": false,
  "hyprAnimations": true,
  "focusFollowsMouse": true,
  "mouseSensitivity": 0,
  "naturalScroll": false,
  "brightnessStep": 5,
  "nightLightEnabled": false,
  "nightLightTemp": 4200,
  "idleDimSeconds": 180,
  "idleLockSeconds": 300,
  "idleDpmsSeconds": 600,
  "volumeStep": 5,
  "allowOverAmplification": false,
  "muteMicOnStartup": false,
  "osdTimeoutMs": 1800,
  "preferredPlayer": "ncspot",
  "wifiScanIntervalSec": 15,
  "btAutoPower": true,
  "btShowBattery": true,
  "powerProfile": "balanced",
  "batteryWarnPercent": 20,
  "batteryCritPercent": 10,
  "caffeineOnFullscreen": true,
  "caffeineOnAc": false,
  "launcherWidth": 680,
  "launcherMaxResults": 9,
  "launcherShowRecent": true,
  "terminalCmd": "ghostty",
  "fileManagerCmd": "yazi",
  "aiPrefix": "?",
  "shellPrefix": ">",
  "calcPrefix": "=",
  "emojiPrefix": ":",
  "aiEnabled": true,
  "aiProvider": "ollama",
  "aiEndpoint": "http://localhost:11434",
  "aiApiKeyEnv": "OPENAI_API_KEY",
  "aiCustomCommand": "gemini -m {model} -p {prompt}",
  "aiModel": "gemma3:1b",
  "aiSystemPrompt": "You are a concise technical assistant on Arch Linux + Hyprland. Give direct answers without filler.",
  "aiTemperature": 0.3,
  "aiStream": true,
  "customModels": []
}